#!/bin/bash
set -euo pipefail

# preview-kit-init: Interactive setup for adopting preview-kit in a repo
# Usage: /path/to/preview-kit/bin/preview-kit-init

readonly PREVIEW_KIT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
readonly REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"

if [[ ! -f "$REPO_ROOT/justfile" ]]; then
  echo "Error: Not in a git repo with a justfile. Are you in the right directory?" >&2
  exit 1
fi

if [[ -f "$REPO_ROOT/preview-kit.toml" ]]; then
  echo "Error: preview-kit.toml already exists in $REPO_ROOT" >&2
  exit 1
fi

if [[ -L "$REPO_ROOT/preview.just" ]]; then
  echo "Error: preview.just symlink already exists in $REPO_ROOT" >&2
  exit 1
fi

echo "=== preview-kit init ==="
echo

# Gather config
read -rp "Project name (e.g. 'Kindred'): " project_name
read -rp "Project prefix (short, e.g. 'kindred'): " project_prefix
read -rp "Host pattern (e.g. '{slug}.dev.khanpikehome.com' or '{slug}.my-project.{domain}'): " host_pattern
read -rp "Health check path (e.g. '/health' or '/api/health'): " health_path
read -rp "Base branch (default: main): " base
base="${base:-main}"
read -rp "Shell service name (e.g. 'app' or 'web'): " shell_service
read -rp "Test service name (leave blank to use shell_service): " test_service
test_service="${test_service:-$shell_service}"
read -rp "Test command (e.g. 'pytest' or 'npm run test'): " test_command

read -rp "Compose file path (default: compose.worktree.yml): " compose_file
compose_file="${compose_file:-compose.worktree.yml}"

# Prompt for ports (optional)
read -rp "Define port mappings? (y/n, default: n): " define_ports
define_ports="${define_ports:-n}"

echo
echo "Creating symlink to preview.just..."
ln -sf "$PREVIEW_KIT_DIR/preview.just" "$REPO_ROOT/preview.just"

echo "Creating preview-kit.toml..."
cat > "$REPO_ROOT/preview-kit.toml" <<EOF
# preview-kit.toml — per-repo config for preview-kit recipes.
# Generated by: preview-kit-init

[preview-kit]
project_name = "$project_name"
project_prefix = "$project_prefix"
host_pattern = "$host_pattern"
compose_file = "$compose_file"
health_path = "$health_path"
base = "$base"
shell_service = "$shell_service"
test_service = "$test_service"
test_command = "$test_command"
EOF

if [[ "$define_ports" == "y" ]]; then
  echo "Adding port section to preview-kit.toml..."
  cat >> "$REPO_ROOT/preview-kit.toml" <<'EOF'

[preview-kit.ports]
APP_PORT = 18000
DB_PORT = 15432
EOF
  echo "(Edit preview-kit.toml to customize port base values)"
fi

# Check and update justfile
echo "Checking justfile for preview.just import..."
if ! grep -q "import 'preview.just'" "$REPO_ROOT/justfile"; then
  echo "Adding import statement to justfile..."
  echo "import 'preview.just'" >> "$REPO_ROOT/justfile"
else
  echo "(import 'preview.just' already present)"
fi

echo
echo "Setup complete! Next steps:"
echo
echo "1. Create $compose_file with your worktree stack config."
echo "   Template: include your main compose.yml services, override"
echo "   COMPOSE_PROJECT_NAME, ports, environment vars, and image tags."
echo
echo "2. Test the setup:"
echo "   cd $REPO_ROOT && just env     # verify env vars"
echo "   just worktree test-branch      # create a test worktree"
echo "   just up                        # bring up the stack"
echo "   just health                    # check health endpoint"
echo
echo "3. Review preview-kit.toml and adjust as needed."
echo
