#!/bin/bash
set -euo pipefail

# preview-kit-init: Smart-default setup for adopting preview-kit in a repo.
# Derives sensible defaults from the repo's basename + git default branch.
#
# Usage: preview-kit-init [--force]
#
# Defaults:
#   project_name   = repo basename
#   project_prefix = repo basename
#   host_pattern   = {slug}.<repo-basename>.{domain}
#   compose_file   = compose.worktree.yml
#   health_path    = /
#   base           = default branch from `git symbolic-ref refs/remotes/origin/HEAD`
#                    (falls back to current branch, then "main")
#   shell_service  = app
#   test_service   = app
#   test_command   = pytest
#
# Override any value by editing preview-kit.toml after generation. Pass
# --force to overwrite existing files.

readonly PREVIEW_KIT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
readonly REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"

force=0
if [[ "${1:-}" == "--force" || "${1:-}" == "-f" ]]; then
  force=1
fi

if [[ ! -f "$REPO_ROOT/justfile" ]]; then
  echo "Error: $REPO_ROOT has no justfile" >&2
  exit 1
fi

if [[ -e "$REPO_ROOT/preview-kit.toml" && $force -eq 0 ]]; then
  echo "Error: $REPO_ROOT/preview-kit.toml already exists (use --force to overwrite)" >&2
  exit 1
fi

if [[ -L "$REPO_ROOT/preview.just" && $force -eq 0 ]]; then
  echo "Error: $REPO_ROOT/preview.just symlink already exists (use --force to overwrite)" >&2
  exit 1
fi

repo_name="$(basename "$REPO_ROOT")"
default_branch="$(git -C "$REPO_ROOT" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null | sed 's|^origin/||' \
  || git -C "$REPO_ROOT" symbolic-ref --short HEAD 2>/dev/null \
  || echo main)"

echo "=== preview-kit init ==="
echo "  repo:           $REPO_ROOT"
echo "  project_name:   $repo_name"
echo "  project_prefix: $repo_name"
echo "  host_pattern:   {slug}.$repo_name.{domain}"
echo "  base branch:    $default_branch"
echo

echo "Creating symlink to preview.just..."
ln -sf "$PREVIEW_KIT_DIR/preview.just" "$REPO_ROOT/preview.just"

echo "Writing preview-kit.toml..."
cat > "$REPO_ROOT/preview-kit.toml" <<EOF
# preview-kit.toml — per-repo config for preview-kit recipes.
# Generated by: preview-kit-init

[preview-kit]
project_name = "$repo_name"
project_prefix = "$repo_name"
host_pattern = "{slug}.$repo_name.{domain}"
compose_file = "compose.worktree.yml"
health_path = "/"
base = "$default_branch"
shell_service = "app"
test_service = "app"
test_command = "pytest"
EOF

# Check and update justfile
if ! grep -q "import 'preview.just'" "$REPO_ROOT/justfile"; then
  echo "Adding 'import preview.just' to justfile..."
  echo "import 'preview.just'" >> "$REPO_ROOT/justfile"
else
  echo "(import 'preview.just' already present in justfile)"
fi

echo
echo "✓ Setup complete."
echo
echo "Next steps:"
echo "  1. Author compose.worktree.yml. Required: a service named 'app' with"
echo "     Traefik (or equivalent reverse-proxy) labels routing \${WORKTREE_HOST}"
echo "     to the dev server port. Every router/service/middleware label name"
echo "     must contain \${SLUG} or \${COMPOSE_PROJECT_NAME} (preview-kit"
echo "     enforces this contract before bringing the stack up)."
echo "  2. Ensure DNS resolves *.$repo_name.<your-domain> at the host running"
echo "     the dev stack, and that your TLS cert (or wildcard cert) covers it."
echo "  3. cd $REPO_ROOT && just env  # verify slug/host derivation"
echo "  4. cd $REPO_ROOT && just dev  # bring up the stack"
